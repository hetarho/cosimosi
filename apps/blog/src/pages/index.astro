---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { PILLARS, type Pillar } from '../content.config.ts'
import { path } from '../site.ts'

// The index groups posts under their research strand, and each group heading carries `id="<pillar>"`.
// That is not decoration: the landing page's five theory cards link straight to `/blog/#<pillar>`, and the
// two sides agree because the pillar enum is closed on this side and pinned by a test on that one.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)

const PILLAR_HEADINGS: Readonly<Record<Pillar, { title: string; note: string }>> = {
  engram: {
    title: '기억 흔적',
    note: '하나의 기억이 뇌에 남기는 물리적 흔적, 그리고 그 흔적을 어떻게 조각으로 나누는지.',
  },
  'spatial-representation': {
    title: '공간과 표상',
    note: '기억을 목록이 아니라 둘러볼 수 있는 공간으로 두는 근거, 그리고 그 공간에서 감정이 하는 일과 하지 않는 일.',
  },
  'synapse-time': {
    title: '연결과 시간',
    note: '연결이 쓰임에 따라 자라고 시드는 방식, 그리고 새 기억이 자리를 찾는 경쟁.',
  },
  'reconstructive-recall': {
    title: '다시 짓는 회상',
    note: '떠올리는 일이 어떻게 기억을 바꾸는지.',
  },
  'forgetting-accessibility': {
    title: '잊음과 접근성',
    note: '잊음이 지워짐이 아니라 길을 잃는 일이라는 관찰, 그리고 남는 것이 요점이라는 관찰.',
  },
}

const groups = PILLARS.map((pillar) => ({
  pillar,
  heading: PILLAR_HEADINGS[pillar],
  entries: posts.filter((post) => post.data.pillar === pillar),
})).filter((group) => group.entries.length > 0)
---

<BaseLayout
  title="cosimosi 노트 — 기억 연구에서 가져온 것들"
  description="cosimosi가 어떤 기억 연구에서 영감을 받았고, 그중 무엇을 가져오고 무엇을 가져오지 않았는지 한 편씩 적어 둔 글 모음입니다."
>
  <section class="index-hero">
    <p class="eyebrow">memory universe notes</p>
    <h1>기억은 별이 되고, 남는 것은 관계입니다.</h1>
    <p class="lede">
      cosimosi가 어떤 연구에서 영감을 받았는지, 그리고 그중 무엇을 실제로 만들었고 무엇은 만들지
      않았는지 한 편씩 적어 둡니다. 처음이라면 「기억 흔적」의 두 편부터 읽으시면 나머지가 술술
      이어져요.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="pillar-group">
        <h2 id={group.pillar}>{group.heading.title}</h2>
        <p class="pillar-note">{group.heading.note}</p>
        <ul class="post-list">
          {group.entries.map((post) => (
            <li>
              <a href={path(`${post.id}/`)}>
                <strong>{post.data.title}</strong>
                <p>{post.data.description}</p>
                <span class="meta">
                  <span class="chip">{post.data.lang}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
