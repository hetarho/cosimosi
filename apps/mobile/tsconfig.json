{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Native",
  // Self-contained instead of extending @react-native/typescript-config: that
  // package is hoisted to the repo-root node_modules and pins a fixed `types`
  // list, which the editor can't always resolve here. The options below mirror the
  // RN base; leaving `types` unset auto-includes @types/jest for the shell tests.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string"
    ],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "resolvePackageJsonImports": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Causes issues with package.json "exports"
    "forceConsistentCasingInFileNames": false,
    // Mirrors packages/ui's alias: `@cosimosi/ui`'s native icon set imports `phosphor-react-native`
    // per glyph, and that subpath is raw TSX whose own source does not typecheck against the
    // installed react-native-svg. Type it from the declarations the library ships; Metro is
    // unaffected and still bundles the real subpath.
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "../../node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
