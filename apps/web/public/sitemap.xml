<?xml version="1.0" encoding="UTF-8"?>
<!--
  The origin's own sitemap. The blog ships its own at /blog/sitemap.xml, which robots.txt names alongside
  this one.

  One URL is listed, and it is /about — the landing page's own address since the origin root became the
  sign-in door. The app is a client-rendered SPA, so every URL is served the same index.html, and that
  shell's <link rel="canonical"> names /about too: the listed URL and the declared canonical have to be
  the same one, or the sitemap would be asking a crawler to index a page that immediately points
  somewhere else.

  The root and /demo are crawl-allowed but unlisted, for the same reason: both answer with a shell that
  declares itself a duplicate of /about, and neither has crawlable content of its own — one is a form,
  the other a JS sandbox. They stay Allow'd so a shared link is never blocked.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://cosimosi.haeram.me/about</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
