# Production / staging .env for a VPS compose stack (spec 14). On the VPS this lives
# UNTRACKED at /srv/cosimosi-<env>/.env — NEVER commit real values (this file is keys
# only). Copy to that path and fill in per environment. docker-compose.prod.yml and the
# Caddyfile read these.

# Image tag the deploy step writes (the commit SHA). compose reads it for BOTH
# `pull` and `up -d` (do not pass IMAGE_TAG inline — it wouldn't reach `up`).
IMAGE_TAG=latest

# --- Database (Supabase) — two URLs on purpose (spec 14 §6) ---
# App runtime → TRANSACTION POOLER (port 6543). default_query_exec_mode=describe_exec is
# REQUIRED: the transaction pooler shares backend connections, so pgx's default named
# prepared-statement cache collides across clients ("prepared statement ... already exists",
# SQLSTATE 42P05). describe_exec uses UNNAMED statements (pooler-safe, no 42P05) while still
# DESCRIBING each statement to learn param OIDs — so it stays type-aware. Do NOT use
# simple_protocol: it drops type info and encodes JSONB []byte params as bytea → every jsonb
# insert fails with "invalid input syntax for type json" (22P02). (exec has the same flaw.)
DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=describe_exec
# Migrations only (goose step) → DIRECT connection (port 5432). DDL must NOT go through
# the pooler. Used by the deploy workflow, not the app container.
DIRECT_DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- HTTP / proxy ---
PORT=8080
# This stack's DNS alias on the shared `edge` docker network. The single edge Caddy
# (deploy/edge, /srv/edge) terminates TLS for api.<도메인>/api.staging.<도메인> and
# proxies here — per-stack caddys would fight over ports 80/443.
API_UPSTREAM=cosimosi-api-staging   # cosimosi-api-prod (prod) | cosimosi-api-staging (staging)
# Allowed browser origin(s) = this environment's frontend domain. Comma-separated for
# multiple (exact match, no wildcards). Read by the API as COSIMOSI_CORS_ORIGINS —
# unset falls back to localhost dev origins only, so a browser gets a CORS error.
COSIMOSI_CORS_ORIGINS=https://cosimosi.example.com
# Keep EMPTY in production: raw internal causes must never enter client payloads. A staging stack
# may temporarily use the exact value "verbose"; unknown values still fail closed.
COSIMOSI_ERROR_DETAIL=

# --- Auth (Supabase, same project as the frontend) ---
# Project base URL → JWKS for verifying asymmetric Supabase tokens. REQUIRED for real
# Supabase logins. SUPABASE_URL is also accepted by the API as an alias.
SUPABASE_PROJECT_URL=https://<ref>.supabase.co
# Server-only legacy service-role key for Auth Admin reads/mutations. REQUIRED by both
# API and worker: account withdrawal refuses to start in production without it.
# Never expose this value through VITE_* or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 shared secret (Dashboard → Settings → API → JWT Secret). Optional when the
# project uses asymmetric signing keys; needed only for HS256 tokens / dev tokens.
SUPABASE_JWT_SECRET=
# Stateless invite-link HMAC key. REQUIRED by the production API; standard base64 encoding of at
# least 32 random bytes — generate with `openssl rand -base64 32`. Server-only: never expose it
# through VITE_* or commit a real value.
INVITE_TOKEN_SIGNING_KEY=

# --- AI providers ---
# Per-capability resolution: admin-console DB selection → these env fallbacks → keyless
# deterministic mock. Prefer /admin for runtime selection and encrypted key storage.
# Leave all three values for a capability blank to use its mock. Implemented providers:
# LLM = anthropic | deepseek; embedding = voyage. Model is optional.
COSIMOSI_LLM_PROVIDER=
COSIMOSI_LLM_API_KEY=
COSIMOSI_LLM_MODEL=
COSIMOSI_EMBEDDING_PROVIDER=
COSIMOSI_EMBEDDING_API_KEY=
COSIMOSI_EMBEDDING_MODEL=

# --- Admin console (spec 34) ---
# AdminService allowlist: comma-separated Supabase user UUIDs (Dashboard →
# Authentication → Users) and/or account emails (JWT sub/email claims).
# Empty = everyone rejected (fail-closed).
ADMIN_USER_IDS=
# AES-256-GCM master key for LLM API keys stored via the admin console.
# base64 32 bytes — generate: openssl rand -base64 32. Server env ONLY.
LLM_KEY_ENCRYPTION_KEY=

# Invite membership gate (spec 41): true (default) = closed-beta gate ON (redeem a code to enter);
# false = transparent (everyone a member). Toggle off to retire the beta gate without code changes.
INVITE_GATE_ENABLED=true

# --- Observability (Sentry, spec 14 §9) ---
SENTRY_DSN=               # empty = disabled (no-op)
# production | staging. Doubles as the error-detail hard-gate: SENTRY_ENVIRONMENT=production
# forces debug_detail masking even if COSIMOSI_ERROR_DETAIL=verbose leaks in (spec/policy/platform/
# errors.md). Set it to `production` on a prod stack EVEN when Sentry is off (empty DSN); a staging
# stack must set `staging` or the verbose diagnostics gate below will be force-masked.
SENTRY_ENVIRONMENT=production   # production | staging
# 프론트 관측 변수(VITE_SENTRY_DSN/VITE_SENTRY_ENVIRONMENT·VITE_POSTHOG_KEY/VITE_POSTHOG_HOST,
# spec 18)는 이 파일이 아니라 Cloudflare Worker 빌드 변수에 넣는다 — DEPLOY.md §3.
