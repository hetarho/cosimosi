# /srv/edge/.env — the shared edge Caddy's variables. DOMAINS ONLY: docker-compose.yml
# injects this whole file into the caddy container (env_file), so nothing secret goes here.
# Runtime secrets belong to each stack's own /srv/cosimosi-<env>/.env (chmod 600).
#
# On a VPS shared with other projects this file ALREADY EXISTS and holds their variables.
# APPEND cosimosi's lines; never overwrite it. Every name carries its project's prefix so
# two projects can never expand a site block to one address (an `ambiguous site definition`
# rejects the entire config and drops TLS for every project on the box).
#
# Both lines are active because both cosimosi fragments in conf.d/ are active. A variable
# must stay set for as long as its fragment is: unset expands to an empty site address and
# Caddy rejects the whole box's config. Retiring an environment means removing its variable
# and renaming its fragment to `.caddy.disabled` in the same step, then validating.

COSIMOSI_API_DOMAIN_PROD=api.cosimosi.haeram.me
COSIMOSI_API_DOMAIN_STAGING=api.staging.cosimosi.haeram.me
